# Server Configuration
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Database Configuration
MONGO_URI=mongodb://localhost:27017/bidwise

# JWT Secrets & Expiries
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Email Service (Mailtrap)
EMAIL_TOKEN=your_mailtrap_token_here

# CORS Configuration (comma-separated allowed origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# File Streaming & Local Storage
FILE_URL_SECRET=your_file_url_hmac_secret_min_32_chars
UPLOAD_DIR=uploads

# AI & Forensics Microservice Integration
AI_SERVICE_URL=http://localhost:8001
AI_REQUEST_TIMEOUT_MS=15000
MOCK_AI=false

# Background Job Worker Configuration
JOB_CONCURRENCY=2
JOB_POLL_INTERVAL_MS=2000
JOB_LOCK_TIMEOUT_MS=300000
